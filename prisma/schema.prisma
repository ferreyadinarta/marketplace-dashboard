generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== MASTER DATA =====

model Store {
  id          String   @id @default(cuid())
  name        String
  marketplace String // SHOPEE | TIKTOK | TOKOPEDIA | KONSINYASI
  apiKey      String?
  apiSecret   String?
  shopIdApi   String? // id toko di sisi marketplace (shop_id)
  logoUrl     String? // URL foto profil toko (diambil saat authorize)
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  syncedFrom  DateTime? // tanggal TERTUA yang sudah tersync penuh → periode lama tak perlu dipindai ulang
  createdAt   DateTime @default(now())

  // OAuth token per toko (diisi otomatis saat toko authorize app kita)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  shopCipher     String? // TikTok: dibutuhkan untuk panggil API per shop

  mappings ProductMapping[]
  orders   Order[]
  payouts  Payout[]
  syncJobs SyncJob[]
}

// Progres sync yang sedang berjalan — ditulis tiap batch oleh proses sync,
// dibaca UI lewat polling supaya user lihat "lagi ngapain", bukan spinner buta.
// Juga bikin sync terjadwal (cron) kelihatan hasilnya.
model SyncJob {
  id      String  @id @default(cuid())
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  storeName String // disalin: job tetap kebaca walau toko dihapus
  scope     String // ALL = tombol "Sync semua toko" / cron, STORE = tombol per toko
  phase     String // queued | orders | done | error

  // posisi kerja — dipakai untuk bar progres
  storeIndex  Int @default(0) // toko ke-berapa (scope ALL)
  storeTotal  Int @default(1)
  windowIndex Int @default(0) // periode 15 harian ke-berapa
  windowTotal Int @default(0)

  ordersDone  Int    @default(0) // order yang sudah diproses di job ini
  ordersTotal Int    @default(0) // order yang sudah ketahuan ada (periode yang sudah dilist)
  created    Int     @default(0)
  updated    Int     @default(0)
  partial    Boolean @default(false) // waktu habis, masih ada sisa

  // dipakai untuk MELANJUTKAN sendiri di panggilan berikutnya
  round Int  @default(1) // putaran ke berapa
  days  Int? // rentang hari yang diminta user
  message    String? // teks pendek untuk UI
  error      String?

  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([finishedAt, updatedAt])
}

model BookkeepingGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique // SKU internal
  hpp         Int    @default(0) // harga pokok penjualan (modal), rupiah
  priceRetail Int    @default(0) // harga jual retail (default penjualan WA/offline)
  priceGrosir Int    @default(0) // harga jual grosir (default penjualan reseller)
  unit        String @default("pcs") // satuan DASAR (kecil): pcs / sachet, dll — stok dihitung di sini
  packUnit    String @default("") // satuan BESAR opsional (ex: box). Kosong = tanpa pack
  packSize    Int    @default(0) // isi per pack (ex: 1 box = 12 sachet). 0 = tanpa pack
  koliUnit    String @default("") // satuan TERBESAR opsional (ex: koli). Kosong = tanpa koli
  koliSize    Int    @default(0) // isi koli dalam PACK (ex: 1 koli = 6 box). 0 = tanpa koli
  minStock    Int    @default(0) // ambang "stok menipis" (low-stock alert), dalam satuan dasar
  lowAlertSent Boolean @default(false) // sudah dikirim notif "stok menipis"? reset saat stok naik lagi (edge-trigger)
  isBundle    Boolean @default(false) // true = bundle (gabungan product lain); tidak di-stok/opname sendiri
  groupId   String?
  group     BookkeepingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  mappings   ProductMapping[]
  orderItems OrderItem[]
  opnames    StockOpname[]
  restocks   StockRestock[]

  // Bundle: isi bundle ini (kalau isBundle) + bundle mana yang memakai product ini
  bundleComponents ProductComponent[] @relation("BundleToComponents")
  usedInBundles    ProductComponent[] @relation("ComponentToBundles")
}

// Isi sebuah bundle: 1 bundle = beberapa product component × qty.
// Bundle sale otomatis mengurangi stok tiap component-nya (lihat lib/stock.ts).
model ProductComponent {
  id          String  @id @default(cuid())
  bundleId    String
  bundle      Product @relation("BundleToComponents", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("ComponentToBundles", fields: [componentId], references: [id], onDelete: Cascade)
  qty         Int // berapa unit component per 1 bundle

  @@unique([bundleId, componentId])
}

// SKU di marketplace bisa beda dengan SKU internal → mapping
model ProductMapping {
  id                     String  @id @default(cuid())
  storeId                String
  store                  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  marketplaceSku         String
  marketplaceProductName String
  // Berapa SATUAN DASAR (mis. sachet) untuk 1 unit yang dijual di marketplace.
  // Contoh: varian "1 box (16 sachet)" → 16, varian "10 sachet" → 10.
  // Master Product = product DASAR; varian marketplace dibedakan oleh angka ini.
  baseQtyPerUnit         Int     @default(1)
  productId              String?
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([storeId, marketplaceSku])
}

// ===== TRANSAKSI =====

model Order {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  marketplaceOrderId String
  orderDate          DateTime
  status             String // PENDING | SHIPPED | COMPLETED | CANCELLED | RETURNED
  buyerName          String? // username/nama pembeli (dari marketplace); kolom "Data" di ledger
  totalAmount        Int      @default(0) // total dibayar pembeli
  marketplaceFee     Int      @default(0) // total potongan fee marketplace
  shippingSubsidy    Int      @default(0)
  netAmount          Int      @default(0) // yang seharusnya cair ke seller
  payoutId           String?
  payout             Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  items OrderItem[]

  @@unique([storeId, marketplaceOrderId])
  @@index([orderDate])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplaceSku String // simpan SKU asli, walau belum ter-mapping
  productName    String
  qty            Int // jumlah dalam SATUAN SAAT DIJUAL (bisa box atau sachet)
  unit           String @default("") // label satuan saat dijual (ex: "box"/"sachet"); kosong → satuan dasar
  baseQty        Int    @default(0) // jumlah dalam satuan DASAR (untuk stok); 0 → fallback ke qty
  price          Int // harga per satuan-jual
  subtotal       Int
  hppSnapshot    Int @default(0) // HPP (modal) per SATUAN DASAR, dibekukan saat jual; 0 → fallback ke product.hpp
}

// ===== STOK / INVENTORY =====

// Hasil stock opname: hitung fisik pada satu waktu → jadi titik "anchor" stok.
// Stok berjalan = countedQty + restock setelah opnameAt − penjualan COMPLETED setelah opnameAt.
// Langganan Web Push (browser/PWA) untuk notifikasi stok menipis.
// Satu baris = satu device/browser yang mengizinkan notifikasi.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique // URL push service (unik per device)
  p256dh    String // kunci publik enkripsi dari browser
  auth      String // secret auth dari browser
  label     String? // opsional: penanda device
  createdAt DateTime @default(now())
}

model StockOpname {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedQty Int // jumlah fisik hasil hitung
  systemQty  Int // stok sistem saat opname (untuk catat selisih)
  note       String?
  opnameAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId, opnameAt])
}

// Barang masuk (restock/pembelian) → menambah stok.
model StockRestock {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  cost      Int      @default(0) // harga beli / unit batch ini (untuk rata-rata HPP)
  note      String?
  restockAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([productId, restockAt])
}

// pencairan dana dari marketplace → untuk rekonsiliasi
model Payout {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payoutDate DateTime
  amount     Int
  reference  String? // no. referensi pencairan
  createdAt  DateTime @default(now())

  orders Order[]
}
