generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== MASTER DATA =====

model Store {
  id          String   @id @default(cuid())
  name        String
  marketplace String // SHOPEE | TIKTOK | TOKOPEDIA | KONSINYASI
  apiKey      String?
  apiSecret   String?
  shopIdApi   String? // id toko di sisi marketplace (shop_id)
  logoUrl     String? // URL foto profil toko (diambil saat authorize)
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())

  // OAuth token per toko (diisi otomatis saat toko authorize app kita)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  shopCipher     String? // TikTok: dibutuhkan untuk panggil API per shop

  mappings ProductMapping[]
  orders   Order[]
  payouts  Payout[]
}

model BookkeepingGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique // SKU internal
  hpp         Int    @default(0) // harga pokok penjualan (modal), rupiah
  priceRetail Int    @default(0) // harga jual retail (default penjualan WA/offline)
  priceGrosir Int    @default(0) // harga jual grosir (default penjualan reseller)
  unit        String @default("pcs") // satuan DASAR (kecil): pcs / sachet, dll — stok dihitung di sini
  packUnit    String @default("") // satuan BESAR opsional (ex: box). Kosong = tanpa pack
  packSize    Int    @default(0) // isi per pack (ex: 1 box = 12 sachet). 0 = tanpa pack
  minStock    Int    @default(0) // ambang "stok menipis" (low-stock alert), dalam satuan dasar
  isBundle    Boolean @default(false) // true = bundle (gabungan product lain); tidak di-stok/opname sendiri
  groupId   String?
  group     BookkeepingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  mappings   ProductMapping[]
  orderItems OrderItem[]
  opnames    StockOpname[]
  restocks   StockRestock[]

  // Bundle: isi bundle ini (kalau isBundle) + bundle mana yang memakai product ini
  bundleComponents ProductComponent[] @relation("BundleToComponents")
  usedInBundles    ProductComponent[] @relation("ComponentToBundles")
}

// Isi sebuah bundle: 1 bundle = beberapa product component × qty.
// Bundle sale otomatis mengurangi stok tiap component-nya (lihat lib/stock.ts).
model ProductComponent {
  id          String  @id @default(cuid())
  bundleId    String
  bundle      Product @relation("BundleToComponents", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("ComponentToBundles", fields: [componentId], references: [id], onDelete: Cascade)
  qty         Int // berapa unit component per 1 bundle

  @@unique([bundleId, componentId])
}

// SKU di marketplace bisa beda dengan SKU internal → mapping
model ProductMapping {
  id                     String  @id @default(cuid())
  storeId                String
  store                  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  marketplaceSku         String
  marketplaceProductName String
  productId              String?
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([storeId, marketplaceSku])
}

// ===== TRANSAKSI =====

model Order {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  marketplaceOrderId String
  orderDate          DateTime
  status             String // PENDING | SHIPPED | COMPLETED | CANCELLED | RETURNED
  buyerName          String? // username/nama pembeli (dari marketplace); kolom "Data" di ledger
  totalAmount        Int      @default(0) // total dibayar pembeli
  marketplaceFee     Int      @default(0) // total potongan fee marketplace
  shippingSubsidy    Int      @default(0)
  netAmount          Int      @default(0) // yang seharusnya cair ke seller
  payoutId           String?
  payout             Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  items OrderItem[]

  @@unique([storeId, marketplaceOrderId])
  @@index([orderDate])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplaceSku String // simpan SKU asli, walau belum ter-mapping
  productName    String
  qty            Int // jumlah dalam SATUAN SAAT DIJUAL (bisa box atau sachet)
  unit           String @default("") // label satuan saat dijual (ex: "box"/"sachet"); kosong → satuan dasar
  baseQty        Int    @default(0) // jumlah dalam satuan DASAR (untuk stok); 0 → fallback ke qty
  price          Int // harga per satuan-jual
  subtotal       Int
  hppSnapshot    Int @default(0) // HPP (modal) per SATUAN DASAR, dibekukan saat jual; 0 → fallback ke product.hpp
}

// ===== STOK / INVENTORY =====

// Hasil stock opname: hitung fisik pada satu waktu → jadi titik "anchor" stok.
// Stok berjalan = countedQty + restock setelah opnameAt − penjualan COMPLETED setelah opnameAt.
model StockOpname {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedQty Int // jumlah fisik hasil hitung
  systemQty  Int // stok sistem saat opname (untuk catat selisih)
  note       String?
  opnameAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId, opnameAt])
}

// Barang masuk (restock/pembelian) → menambah stok.
model StockRestock {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  cost      Int      @default(0) // harga beli / unit batch ini (untuk rata-rata HPP)
  note      String?
  restockAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([productId, restockAt])
}

// pencairan dana dari marketplace → untuk rekonsiliasi
model Payout {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payoutDate DateTime
  amount     Int
  reference  String? // no. referensi pencairan
  createdAt  DateTime @default(now())

  orders Order[]
}
